{
  "$schema": "yzphotos.design-tokens/v2",
  "meta": {
    "project": "YZPhotos",
    "platform": "iOS / iPadOS 18+",
    "themes": ["light", "dark", "glass"],
    "default_theme": "glass",
    "note": "Le système a 3 thèmes sélectionnables. 'light' = neutre/Linear (accent indigo, fonds clairs, texte sombre). 'dark' = même système en sombre. 'glass' = Liquid Glass sur aurora Storm Blue (direction principale). Les couleurs garder/poubelle changent par thème : vives et fonctionnelles en light/dark, accordées à la palette Optimistic Synergy en glass."
  },

  "palette_optimistic_synergy": {
    "carmine": "#B23A5D",
    "storm_blue": "#3D5A6C",
    "old_gold": "#D2A53F",
    "confetti": "#E88AA0",
    "sulphur": "#C3D24A",
    "mandarin": "#E87B3E"
  },

  "themes": {
    "light": {
      "bg": "#FFFFFF",
      "bg2": "#F4F4F6",
      "bg3": "#ECECEF",
      "card": "#FFFFFF",
      "elevated": "#FFFFFF",
      "separator": "rgba(0,0,0,0.075)",
      "separator_strong": "rgba(0,0,0,0.12)",
      "text_primary": "#161618",
      "text_secondary": "#6A6A70",
      "text_tertiary": "#A0A0A8",
      "accent": "#5B5BD6",
      "accent_soft": "#ECECFB",
      "keep": "#28B463",
      "keep_soft": "#E6F7EE",
      "trash": "#E5484D",
      "trash_soft": "#FCEBEC",
      "warn": "#E08600",
      "warn_soft": "#FBF1E0",
      "shadow_card": "0 1px 2px rgba(0,0,0,0.04), 0 6px 18px rgba(0,0,0,0.07)",
      "shadow_float": "0 2px 8px rgba(0,0,0,0.08), 0 12px 28px rgba(0,0,0,0.12)"
    },
    "dark": {
      "bg": "#0C0C0E",
      "bg2": "#161618",
      "bg3": "#202024",
      "card": "#161618",
      "elevated": "#1C1C20",
      "separator": "rgba(255,255,255,0.08)",
      "separator_strong": "rgba(255,255,255,0.14)",
      "text_primary": "#F4F4F6",
      "text_secondary": "#9A9AA2",
      "text_tertiary": "#5E5E66",
      "accent": "#8A88FF",
      "accent_soft": "#22223A",
      "keep": "#3DD27F",
      "keep_soft": "#11271C",
      "trash": "#FF5C61",
      "trash_soft": "#2C1314",
      "warn": "#F5A623",
      "warn_soft": "#2A2010",
      "shadow_card": "0 1px 2px rgba(0,0,0,0.4)",
      "shadow_float": "0 2px 12px rgba(0,0,0,0.5)"
    },
    "glass": {
      "background_gradient": "linear-gradient(160deg, #3A5C6E 0%, #244252 46%, #10242E 100%)",
      "bg2": "rgba(255,255,255,0.12)",
      "bg3": "rgba(255,255,255,0.18)",
      "card": "rgba(255,255,255,0.14)",
      "elevated": "rgba(40,62,74,0.6)",
      "separator": "rgba(255,255,255,0.16)",
      "separator_strong": "rgba(255,255,255,0.30)",
      "text_primary": "#FFFFFF",
      "text_secondary": "rgba(255,255,255,0.82)",
      "text_tertiary": "rgba(255,255,255,0.58)",
      "accent": "#E87B3E",
      "accent_soft": "rgba(255,255,255,0.22)",
      "keep": "#B6D84B",
      "trash": "#F06A8C",
      "warn": "#F0B43E",
      "glass_fill": "rgba(255,255,255,0.14)",
      "glass_fill_strong": "rgba(255,255,255,0.22)",
      "glass_border": "0.5px solid rgba(255,255,255,0.45)",
      "glass_backdrop_filter": "blur(24px) saturate(1.65)",
      "glass_inner_highlight": "inset 0 0.5px 0.5px rgba(255,255,255,0.9), inset 0 0 0 0.5px rgba(255,255,255,0.16)",
      "glass_drop_shadow": "0 14px 40px rgba(8,28,38,0.4)"
    }
  },

  "radius_px": { "chip": 8, "button": 12, "card": 16, "modal": 22 },
  "typography": {
    "family": "-apple-system, SF Pro Display, SF Pro Text",
    "display_weight": 800,
    "display_letter_spacing_em": -0.03,
    "scale_px": { "large_title": 34, "title1": 30, "title2": 22, "headline": 17, "body": 16, "subhead": 14, "footnote": 13, "caption": 11 }
  }
}
