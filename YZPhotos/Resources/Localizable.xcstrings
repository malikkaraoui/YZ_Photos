          }
        }
      }
    },
    "Le disque n'est pas accessible. Branche-le, attends quelques secondes, puis réessaie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive isn't reachable. Plug it in, wait a few seconds, then try again."
