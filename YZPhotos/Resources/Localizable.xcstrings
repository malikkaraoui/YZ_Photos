    "Tri rapide de photos et vidéos sur disque USB-C ou réseau (SMB). Repère les doublons, libère de l'espace, sans jamais déplacer tes fichiers sans toi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quickly sort photos and videos on a USB-C or network (SMB) drive. Spot duplicates, free up space, and never move your files without you."
          }
        }
      }
    },
    "Fermer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
