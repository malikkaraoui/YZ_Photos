          "stringUnit": {
            "state": "translated",
            "value": "Unknown test"
          }
        }
      }
    },
    "Non applicable à un disque réseau — utilise « Tester la connexion SMB » plus bas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not applicable to a network drive — use \"Test SMB connection\" below."
