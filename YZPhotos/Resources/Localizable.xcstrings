      }
    },
    "Copies identiques d'abord, puis quasi-identiques (rafales, recompressions).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identical copies first, then near-identical ones (bursts, recompressions)."
          }
        }
      }
    },
