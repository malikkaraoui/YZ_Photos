    "Aucune bibliothèque Photos sur ce disque — test sans objet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Photos library on this drive — test not applicable."
          }
        }
      }
    },
    "Fichier sorti puis remis en place en %lf ms (%@). Le tri dans les bibliothèques est fiable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File moved out and back in place in %lf ms (%@). Sorting inside libraries is reliable."
          }
        }
      }
    },
    "Le disque refuse de sortir des fichiers d'une bibliothèque Photos. Dis-le-moi : il faudra passer en copie+suppression. (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive refuses to move files out of a Photos library. Let me know: we'll need to switch to copy+delete. (%@)"
          }
        }
      }
    },
    "%lld fichiers listés en %lf s → %lf fichiers/seconde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files listed in %lf s → %lf files/second."
          }
        }
      }
    },
    "Lent : %lf fichiers/seconde. L'étape 1 de l'analyse sera longue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow: %lf files/second. Step 1 of the scan will take a while."
          }
        }
      }
    },
    "Aucun fichier média trouvé sur le disque.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No media file found on the drive."
          }
        }
      }
    },
    "%lld empreintes en %lf s → %lf/seconde (et l'analyse réelle travaille sur 8 fichiers à la fois).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fingerprints in %lf s → %lf/second (and the real scan works on 8 files at a time)."
          }
        }
      }
    },
    "Lent : %lf empreintes/seconde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow: %lf fingerprints/second."
          }
        }
      }
    },
    "Aucune photo trouvée sur le disque.": {
      "localizations": {
        "en": {
